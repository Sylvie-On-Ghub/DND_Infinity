// Cloudflare Workers config for hosting the web build. No server code, just the files from
// `npx expo export -p web`. Unknown paths serve index.html so routes like /character/123 load on refresh.
{
  "name": "dnd-infinity",
  "compatibility_date": "2026-10-01",
  // Only serve on the custom domain, where the zone's security rules apply. The workers.dev
  // and preview URLs would skip them.
  "routes": [{ "pattern": "app.transdev.me.uk", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
